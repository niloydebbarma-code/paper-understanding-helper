{
  "name": "agentic-research-reviewer",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:aws": "tsx scripts/test-aws/test-all-aws.ts",
    "test:api": "tsx scripts/test-api-endpoints.ts",
    "test:frontend": "tsx scripts/test-frontend-components.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1135.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1135.0",
    "@aws-sdk/client-dynamodb": "^3.1135.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/client-textract": "^3.1135.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "katex": "^0.18.7",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.0.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
